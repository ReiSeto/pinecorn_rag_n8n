# === Google Sheets OAuth2 ===
GOOGLE_SHEETS_OAUTH2_CLIENT_ID=your_client_id
GOOGLE_SHEETS_OAUTH2_CLIENT_SECRET=your_client_secret

# === Google Drive OAuth2 ===
GOOGLE_DRIVE_OAUTH2_CLIENT_ID=your_client_id
GOOGLE_DRIVE_OAUTH2_CLIENT_SECRET=your_client_secret

# === Pinecone ===
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=your_index_name

# === Google Gemini (PaLM) ===
GOOGLE_GEMINI_API_KEY=your_gemini_api_key

# === Groq ===
GROQ_API_KEY=your_groq_api_key

# === Google Sheets Document IDs ===
# Thay bằng document ID thực tế trên Google Sheets của bạn
SHEET_SALEORDER_ID=your_saleorder_sheet_id
SHEET_ACCOUNT_ID=your_account_sheet_id
SHEET_PRODUCT_ID=your_product_sheet_id
SHEET_MERGED_ID=your_merged_sheet_id

# === Google Drive Folder ID ===
GDRIVE_FOLDER_ID=your_drive_folder_id
